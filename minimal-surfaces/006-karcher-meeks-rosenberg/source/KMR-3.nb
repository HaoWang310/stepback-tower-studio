14ef17901e68"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"G", "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"z", "+", "\[Epsilon]"}], ")"}], "/", 
    RowBox[{"(", " ", 
     RowBox[{"z", "-", "\[Epsilon]"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dh", "[", "z_", "]"}], ":=", 
  RowBox[{"I", "/", 
   RowBox[{"(", " ", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"z", "^", "2"}], "-", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "\[Alpha]"}], "]"}], "-", 
       SqrtBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox[
          RowBox[{"Cos", "[", 
           RowBox[{"2", " ", "\[Alpha]"}], "]"}], "2"]}]]}], "]"}], 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"z", "^", "2"}], "-", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "\[Alpha]"}], "]"}], "+", 
       SqrtBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox[
          RowBox[{"Cos", "[", 
           RowBox[{"2", " ", "\[Alpha]"}], "]"}], "2"]}]]}], "]"}]}], 
    ")"}]}]}]}], "Input",ExpressionUUID->"41fa4aaa-f992-46f7-8c05-\
98f3546d940b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"phi1", "[", "z_", "]"}], ":=", 
    RowBox[{
     RowBox[{"G", "[", "z", "]"}], 
     RowBox[{"dh", "[", "z", "]"}]}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"phi2", "[", "z_", "]"}], ":=", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"G", "[", "z", "]"}]}], 
     RowBox[{"dh", "[", "z", "]"}]}]}], ";"}], " ", "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]1", "[", "z_", "]"}], " ", ":=", 
   RowBox[{
    RowBox[{"(", " ", 
     RowBox[{
      RowBox[{"phi2", "[", "z", "]"}], "-", 
      RowBox[{"phi1", "[", "z", "]"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]2", "[", "z_", "]"}], " ", ":=", 
   RowBox[{"I", 
    RowBox[{
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{"phi1", "[", "z", "]"}], "+", 
       RowBox[{"phi2", " ", "[", "z", "]"}]}], ")"}], "/", "2"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]3", "[", "z_", "]"}], " ", ":=", 
   RowBox[{"dh", "[", "z", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.409584668651819*^9, 
  3.409584671015325*^9}},ExpressionUUID->"dd2b7bc6-b3fc-4580-8b46-\
b6650f0b91b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f1", "[", "w_", "]"}], " ", ":=", "  ", 
  RowBox[{"Re", "[", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Omega]1", "[", "z", "]"}], ",", 
       RowBox[{"\[Omega]2", "[", "z", "]"}], ",", 
