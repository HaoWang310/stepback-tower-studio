Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Alpha]", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Pi", "/", "2"}], "-", 
     RowBox[{"Pi", "/", "8"}]}], "//", "N"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Phi]", "=", 
   RowBox[{
    RowBox[{"Pi", "/", "4"}], "//", "N"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Epsilon]", "=", 
   RowBox[{"E", "^", 
    RowBox[{"(", 
     RowBox[{"I", " ", "\[Phi]"}], ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.4095873609030647`*^9, 3.409587362215868*^9}, {
   3.409587419299925*^9, 3.409587421513556*^9}, 3.409587455180839*^9, {
