  3.409584957162417*^9}},ExpressionUUID->"07f830de-c86d-42ea-a6e4-\
1d9359757cff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"m3", "=", 
   RowBox[{"MeshJoin", "[", 
    RowBox[{"m2", ",", 
     RowBox[{"MeshRotate", "[", 
      RowBox[{"m2", ",", 
       RowBox[{"StraightLine", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
