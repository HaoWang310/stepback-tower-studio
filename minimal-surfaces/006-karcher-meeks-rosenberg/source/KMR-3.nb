Cell[BoxData[
 RowBox[{
  RowBox[{"m4", "=", 
   RowBox[{"MeshJoin", "[", 
    RowBox[{"m3", ",", 
     RowBox[{"MeshTranslate", "[", 
      RowBox[{"m3", ",", 
       RowBox[{"2", 
        RowBox[{"{", 
         RowBox[{"0", ",", "disy", ",", "disz"}], "}"}]}]}], "]"}]}], "]"}]}],
   ";"}]], "Input",
