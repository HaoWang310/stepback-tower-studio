84bdd9cefb8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"m2", "=", 
   RowBox[{"MeshJoin", "[", 
    RowBox[{"m1", ",", 
     RowBox[{"MeshReflect", "[", 
      RowBox[{"m1", ",", 
       RowBox[{"Plane", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", "0"}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
