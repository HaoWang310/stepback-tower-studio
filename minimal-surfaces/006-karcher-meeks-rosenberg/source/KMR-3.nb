Cell[BoxData[
 RowBox[{
  RowBox[{"m1", "=", 
   RowBox[{"MeshPlot3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"x", "+", 
         RowBox[{"I", " ", "y"}]}], "]"}], ",", 
       RowBox[{"n", "[", 
        RowBox[{"x", "+", 
