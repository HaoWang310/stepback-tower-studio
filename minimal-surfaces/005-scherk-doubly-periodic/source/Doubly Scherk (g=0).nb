Cell[BoxData[{
 RowBox[{
  RowBox[{"xmin", "=", ".015"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nx", "=", "30"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ny", "=", "30"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Epsilon]", "=", "0.000000001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xspec", "=", 
   RowBox[{"{", 
    RowBox[{"xmin", ",", 
     RowBox[{"1", "-", "\[Epsilon]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fff", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
   RowBox[{"ExpNRange", "[", 
    RowBox[{"x", ",", "y", ",", "nx"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"XR", "=", 
   RowBox[{"Union", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"fff", "/@", 
       RowBox[{"Partition", "[", 
        RowBox[{"xspec", ",", "2", ",", "1"}], "]"}]}], "]"}], ",", 
     RowBox[{"SameTest", "\[Rule]", "AlmostEqual"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"YR", "=", 
   RowBox[{"NRange", "[", 
    RowBox[{"\[Epsilon]", ",", 
     RowBox[{"Pi", "-", "\[Epsilon]"}], ",", "ny"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xr", "=", 
