Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]1", "[", "z_", "]"}], " ", ":=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{"phi1", "[", "z", "]"}], "-", 
       RowBox[{"phi2", "[", "z", "]"}]}], ")"}]}], "/", "2"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]2", "[", "z_", "]"}], " ", ":=", 
   RowBox[{"I", 
