Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"phi1", "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Rho]", "/", "z"}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"z", "-", "1"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"z", "+", "1"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"phi2", "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "\[Rho]"}], "/", "z"}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"z", "-", "1"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"z", "+", "1"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}], ")"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.739165980436795*^9, 3.7391660039961243`*^9}, {
  3.7391660606444902`*^9, 3.739166140572846*^9}, {3.739166220775988*^9, 
